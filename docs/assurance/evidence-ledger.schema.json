{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-assurance/v1",
  "title": "Platform assurance evidence ledger record",
  "description": "One sanitized record per executed command or gate. No field may carry a secret, private path, address, route, unit name, username, or private inventory value; private resources appear as finite public tokens only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "time_utc",
    "base_commit",
    "branch",
    "phase",
    "control",
    "command_id",
    "result",
    "evidence_sha256",
    "private_data",
    "notes"
  ],
  "properties": {
    "schema": { "const": "platform-assurance/v1" },
    "time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "branch": { "type": "string", "pattern": "^fable/platform-[a-z0-9-]+$" },
    "phase": { "type": "string", "pattern": "^[A-G]$" },
    "control": { "type": "string", "pattern": "^PLAT-[A-Z0-9]+-[0-9]{3}$" },
    "command_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "evidence_sha256": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "private_data": { "const": "ABSENT" },
    "notes": { "type": "string", "maxLength": 400, "pattern": "^[\\x20-\\x7E]*$" }
  }
}
