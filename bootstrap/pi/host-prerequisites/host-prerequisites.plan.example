# Generate the real root-only plan on the Pi with discover-host-prerequisites.sh.
# This example is deliberately invalid and must never be used for --apply.
PLAN_VERSION=1
PLAN_STATUS=UNRESOLVED_REVIEW_REQUIRED
MODULES_TARGET=/etc/modules-load.d/90-website-infrastructure-kubeadm.conf
SYSCTL_TARGET=/etc/sysctl.d/90-website-infrastructure-kubeadm.conf
FSTAB_TARGET=/etc/fstab
BACKUP_ROOT=/var/backups/website-infrastructure/host-prerequisites
STATE_ROOT=/var/lib/website-infrastructure/host-prerequisites
DESIRED_MODULES=overlay,br_netfilter
EXPECTED_ARCHITECTURE=REPLACE_FROM_DISCOVERY
EXPECTED_KERNEL_RELEASE=REPLACE_FROM_DISCOVERY
EXPECTED_MACHINE_ID_SHA256=REPLACE_FROM_DISCOVERY
EXPECTED_BOOT_ID_SHA256=REPLACE_FROM_DISCOVERY
EXPECTED_OS_RELEASE_SHA256=REPLACE_FROM_DISCOVERY
EXPECTED_MODULES_TARGET_STATE=REPLACE_FROM_DISCOVERY
EXPECTED_SYSCTL_TARGET_STATE=REPLACE_FROM_DISCOVERY
EXPECTED_FSTAB_SHA256=REPLACE_FROM_DISCOVERY
EXPECTED_ACTIVE_SWAP_SHA256=REPLACE_FROM_DISCOVERY
DESIRED_MODULES_SHA256=REPLACE_FROM_DISCOVERY
DESIRED_SYSCTL_SHA256=REPLACE_FROM_DISCOVERY
SWAP_MECHANISM=UNRESOLVED_FROM_DISCOVERY
SWAP_ACTION=UNRESOLVED_FROM_DISCOVERY
CURRENT_VM_OVERCOMMIT_MEMORY=REPLACE_FROM_DISCOVERY
CURRENT_VM_PANIC_ON_OOM=REPLACE_FROM_DISCOVERY
CURRENT_KERNEL_PANIC=REPLACE_FROM_DISCOVERY
CURRENT_KERNEL_PANIC_ON_OOPS=REPLACE_FROM_DISCOVERY
CURRENT_KERNEL_KEYS_ROOT_MAXKEYS=REPLACE_FROM_DISCOVERY
CURRENT_KERNEL_KEYS_ROOT_MAXBYTES=REPLACE_FROM_DISCOVERY
CURRENT_NET_IPV4_IP_FORWARD=REPLACE_FROM_DISCOVERY
CURRENT_NET_BRIDGE_BRIDGE_NF_CALL_IPTABLES=REPLACE_FROM_DISCOVERY_OR_unavailable-until-module-load
CURRENT_NET_BRIDGE_BRIDGE_NF_CALL_IP6TABLES=REPLACE_FROM_DISCOVERY_OR_unavailable-until-module-load
DESIRED_VM_OVERCOMMIT_MEMORY=1
DESIRED_VM_PANIC_ON_OOM=0
DESIRED_KERNEL_PANIC=10
DESIRED_KERNEL_PANIC_ON_OOPS=1
DESIRED_KERNEL_KEYS_ROOT_MAXKEYS=1000000
DESIRED_KERNEL_KEYS_ROOT_MAXBYTES=25000000
DESIRED_NET_IPV4_IP_FORWARD=1
DESIRED_NET_BRIDGE_BRIDGE_NF_CALL_IPTABLES=1
DESIRED_NET_BRIDGE_BRIDGE_NF_CALL_IP6TABLES=1
