# Copy this file to the gitignored protected-services.env.local, set mode 0600,
# list only units discovered on the Pi, and change the review flag after a human
# confirms the inventory. Never commit the local file or its unit names.
PROTECTED_SERVICES_REVIEWED=no

# A separate review flag covers protected legacy archive roots and every
# activation path, including locally reviewed user units, containers, package
# presets/generators, cron, and desktop autostart that cannot be represented by
# the repeated systemd key below. Any unknown keeps this flag at no. The public
# template stays unapproved even when a fork has no entries.
PROTECTED_LEGACY_ARCHIVES_REVIEWED=no

# Choose exactly yes or no after local discovery. "yes" requires at least one
# dedicated root and its bounded mount-binding SHA-256; "no" requires every
# legacy archive/unit declaration below to remain empty. "unknown" deliberately
# keeps a copied template invalid.
PROTECTED_LEGACY_ARCHIVES_PRESENT=unknown

# Uncomment every generic activation class only after its private evidence has
# been reviewed. The validator requires this exact complete set; these are
# classifications, never unit names or host identities.
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=containers
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=package-activation
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=runtime-exposure
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=scheduled-autostart
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=system-manager-units
# PROTECTED_LEGACY_ACTIVATION_CLASS_REVIEWED=user-manager-units

# Repeat this key for each local unit that bootstrap must prove remains active.
# PROTECTED_SYSTEMD_UNIT=REPLACE_WITH_LOCAL_UNIT.service

# Repeat the root key for each dedicated local archive directory. The validator
# rejects relative, broad, overlapping, symlinked, or group/world-accessible
# roots without printing their values.
# PROTECTED_LEGACY_ARCHIVE_ROOT=REPLACE_WITH_LOCAL_ABSOLUTE_DIRECTORY

# After listing roots, derive bounded metadata-only values with
# `python3 scripts/validate_protected_host_contract.py CONTRACT --emit-bindings`,
# then append one line per root in the same order. Never substitute a recursive
# content hash or print paths in shareable evidence.
# PROTECTED_LEGACY_ARCHIVE_BINDING_SHA256=REPLACE_WITH_LOCAL_SHA256

# For either yes or no, privately complete the fixed adjacent
# protected-legacy-runtime-evidence.local review, make its presence decision
# match this contract, keep both files mode 0600, and append exactly one
# assignment emitted by
# `python3 scripts/validate_protected_runtime_evidence.py CONTRACT --emit-sha256`.
# The emitter securely validates this adjacent contract and refuses a mismatched
# presence decision. Its short-lived binding is invalid after 600 seconds or any
# reboot. Omission is accepted only while deriving archive bindings with
# --emit-bindings; that command is derivation only, never authorization. A final
# static or live contract always requires the binding so changing yes to no
# cannot bypass the reviewed storage and activation inventory.
# PROTECTED_LEGACY_RUNTIME_EVIDENCE_SHA256=REPLACE_WITH_LOCAL_SHA256

# Repeat the unit key for every system-manager legacy activation source that
# must be exactly inactive, have no control group, and be persistently disabled
# or masked. User-manager units belong in separate private review evidence and
# must never be entered here. Supported suffixes are service/socket/timer/path.
# PROTECTED_LEGACY_SYSTEMD_UNIT=REPLACE_WITH_LOCAL_UNIT.service
