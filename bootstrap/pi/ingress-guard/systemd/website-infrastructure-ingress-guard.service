[Unit]
Description=SSH-only admin-ingress guard for the Kubernetes control plane
Documentation=https://github.com/snaraj/website-infrastructure
# PLAT-DEC-001: the guard loads before interfaces come up and before kubelet
# can ever start a listener. There is deliberately no Condition* line — a
# skipped condition would still satisfy the kubelet Requires= dependency, so
# a missing contract must FAIL this unit (and therefore block kubelet), never
# silently skip it.
Wants=network-pre.target
Before=network-pre.target kubelet.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/website-infrastructure-ingress-guard-load
RuntimeDirectory=website-infrastructure-ingress-guard
RuntimeDirectoryMode=0700
TimeoutStartSec=2min
# The sandbox permits exactly what a transactional nftables load needs:
# netlink with CAP_NET_ADMIN, the read-only contract/library paths, and a
# private root-owned runtime directory for rendered rules and captures. Any
# sandbox failure blocks kubelet (fail closed); loosening one of these lines
# requires a reviewed PR, never a runtime toggle.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/website-infrastructure /usr/local/lib/website-infrastructure
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
IPAddressDeny=any
CapabilityBoundingSet=CAP_NET_ADMIN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
