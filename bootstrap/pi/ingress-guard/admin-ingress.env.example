# Private-input contract for the SSH-only admin-ingress guard (PLAT-DEC-001).
#
# Create the reviewed copy directly at the root-owned, mode-0700 custody path
# /var/lib/website-infrastructure/ingress-guard/input/admin-ingress.env ON THE
# PI (never in a checkout or on a workstation). The file itself must be
# root-owned mode 0600 with exactly one hard link. Declare each reviewed
# administrative VPN ingress interface and flip the review flag only after a
# human confirms the list is exactly the reviewed admin plane. The transaction
# installs only that root-custodied file. Never commit the private file,
# its interface names, a hash of its contents, or its interface count.
#
# The validator (scripts/validate_admin_ingress_contract.py) rejects
# duplicates, whitespace ambiguity, unexpected keys, symlinks, extra hard
# links, non-root ownership, partial files, and loopback/LAN/WLAN/bridge/CNI
# interface classes — a declaration can never aim the guard at the path local
# kubectl, the LAN recovery plane, or the pod network uses. Diagnostics are
# fixed value-free tokens.
ADMIN_INGRESS_REVIEWED=no

# Repeat this key once per reviewed administrative VPN ingress interface
# (dedicated tunnel-class names only, 2-15 chars, lowercase). The guard will
# keep TCP 22 reachable from these interfaces and terminally deny TCP 2379,
# 2380, 6443, and 10250 for new and established flows.
# ADMIN_INGRESS_INTERFACE=REPLACE_WITH_LOCAL_ADMIN_VPN_INTERFACE
