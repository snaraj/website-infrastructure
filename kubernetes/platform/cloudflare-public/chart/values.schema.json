{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "tunnel", "connectors", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "const": "cloudflare/cloudflared"},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]}
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretKey"],
      "properties": {
        "secretKey": {"type": "string", "const": "token"}
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naranjo-online", "lidersea-com"],
      "properties": {
        "naranjo-online": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance", "secretName", "tokenRevision", "origin"],
          "properties": {
            "instance": {"type": "string", "const": "naranjo-online-tunnel"},
            "secretName": {"type": "string", "const": "naranjo-online-tunnel-token"},
            "tokenRevision": {
              "type": "string",
              "pattern": "^(?:not-configured|UNRESOLVED|rev-[a-z0-9][a-z0-9._-]{0,62})$"
            },
            "origin": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "podLabels", "port"],
              "properties": {
                "namespace": {"type": "string", "const": "naranjo-online"},
                "podLabels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["app.kubernetes.io/name"],
                  "properties": {"app.kubernetes.io/name": {"type": "string", "const": "naranjo-online"}}
                },
                "port": {"type": "integer", "const": 8080}
              }
            }
          }
        },
        "lidersea-com": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance", "secretName", "tokenRevision", "origin"],
          "properties": {
            "instance": {"type": "string", "const": "lidersea-com-tunnel"},
            "secretName": {"type": "string", "const": "lidersea-com-tunnel-token"},
            "tokenRevision": {
              "type": "string",
              "pattern": "^(?:not-configured|UNRESOLVED|rev-[a-z0-9][a-z0-9._-]{0,62})$"
            },
            "origin": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "podLabels", "port"],
              "properties": {
                "namespace": {"type": "string", "const": "lidersea-com"},
                "podLabels": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["app.kubernetes.io/name"],
                  "properties": {"app.kubernetes.io/name": {"type": "string", "const": "lidersea-com"}}
                },
                "port": {"type": "integer", "const": 8080}
              }
            }
          }
        }
      }
    },
    "resources": {"type": "object"}
  }
}
